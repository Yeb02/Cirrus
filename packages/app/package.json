{
  "name": "@cirrus/app",
  "version": "0.1.0",
  "description": "Cirrus, un graphe de connaissances personnel",
  "author": "Yeb02",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite build && electron-vite preview",
    "capture": "electron-vite build && node scripts/capture.mjs",
    "captures": "electron-vite build && node scripts/captures.mjs",
    "compare-captures": "node scripts/compare-captures.mjs",
    "interface": "electron-vite build && node scripts/interface.mjs",
    "mesures": "electron-vite build && node scripts/mesures-annotations.mjs",
    "essai": "electron-vite build && node scripts/essai.mjs",
    "font": "node scripts/build-font.mjs",
    "bench": "electron-vite build && node scripts/bench.mjs",
    "icones": "node scripts/icones.mjs",
    "paquet": "electron-vite build && electron-builder --win nsis --publish never",
    "paquet:dev": "electron-vite build --mode dev && electron-builder --win nsis --publish never --config electron-builder.dev.yml"
  },
  "dependencies": {
    "@cirrus/core": "*",
    "@cirrus/sources": "*",
    "@cirrus/store": "*",
    "@cirrus/view": "*",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/lint": "6.9.7",
    "@codemirror/merge": "6.12.3",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "electron-updater": "6.8.11",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cirrus/fixtures": "*",
    "@cirrus/server": "*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "msdf-bmfont-xml": "^2.8.0",
    "vite": "8.3.5"
  }
}
