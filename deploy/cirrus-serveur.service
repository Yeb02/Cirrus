# Cirrus's server on the rented machine (plan 9, D2). deploy/installer-serveur.sh puts it in /etc/systemd/system, and
# deploy/mettre-a-jour.sh puts it back when a version changes it. The server listens on this machine only
# (127.0.0.1:7310): Caddy, in front of it, carries the HTTPS. Its domain, CIRRUS_NOM, is in /etc/cirrus/serveur.env,
# which the SSH commands (cirrus-serveur) read too.
[Unit]
Description=Serveur Cirrus
Documentation=https://github.com/Yeb02/Cirrus/blob/main/deploy/LISEZ-MOI.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cirrus
Group=cirrus
EnvironmentFile=/etc/cirrus/serveur.env
WorkingDirectory=/var/lib/cirrus
# Node 26 runs the server's TypeScript itself, its types stripped, and has node:sqlite: no build step, no flag. Its data
# are given (--data): as cirrus, the default would be another folder.
ExecStart=/usr/bin/node /opt/cirrus/packages/server/src/main.ts serve --data /var/lib/cirrus
Restart=on-failure
RestartSec=5s
# SIGTERM closes the server in order (main.ts): its connections cut, the base and serveur.db closed.
TimeoutStopSec=60s
UMask=0077

# The hardening: the server reads its code and its versions, and writes its data, nothing else. Its temporary files are under its data
# (files/.import-…); /tmp is its own all the same.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/cirrus
# The versions served are root's, in /var/lib/cirrus-maj/versions (deploy/mettre-a-jour.sh writes them): the server sees
# them read-only where it looks for them, <data>/versions, the same files (so the same inodes, one name each). cirrus can
# neither change them nor turn root's writes elsewhere (review of task 6, I1). Without the folder, the service does not
# start, rather than serve a folder cirrus could write.
BindReadOnlyPaths=/var/lib/cirrus-maj/versions:/var/lib/cirrus/versions
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
